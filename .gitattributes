# 统一换行符，避免 Windows 和 Linux 之间来回改
* text=auto eol=lf

# 批处理和 PowerShell 必须是 CRLF —— 裸 LF 会让 cmd.exe 解析出错
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制
*.png binary
*.ico binary
*.onnx binary
*.dll binary
*.exe binary
*.bz2 binary

# 这些是程序自己下载的，不要参与 diff 和统计
sherpa/** linguist-vendored
models/** linguist-vendored

# 让 GitHub 的语言统计别把工具脚本算进去
tools/selftest_*.py linguist-documentation
